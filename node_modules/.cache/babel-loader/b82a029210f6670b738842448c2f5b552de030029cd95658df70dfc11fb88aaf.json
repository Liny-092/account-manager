6","_toDisplayString","url","_hoisted_7","account","_hoisted_8","handleEdit","title","_hoisted_9","handleDelete","_hoisted_10","length","_hoisted_11"],"sources":["C:\\Users\\23946\\Desktop\\account-manager\\src\\components\\SavedRecords.vue"],"sourcesContent":["<template>\r\n    <div class=\"saved-records\">\r\n      <h2 class=\"title\">已保存记录</h2>\r\n      \r\n      <!-- 筛选标签 -->\r\n      <div class=\"filter-tabs\">\r\n        <button \r\n          :class=\"['tab-btn', { active: activeTab === 'all' }]\"\r\n          @click=\"activeTab = 'all'\"\r\n        >\r\n          全部\r\n        </button>\r\n        <button \r\n          :class=\"['tab-btn', { active: activeTab === 'recent' }]\"\r\n          @click=\"activeTab = 'recent'\"\r\n        >\r\n          最近\r\n        </button>\r\n        <input \r\n          type=\"text\" \r\n          class=\"search-input\" \r\n          placeholder=\"搜索\" \r\n          v-model=\"searchQuery\"\r\n        />\r\n      </div>\r\n  \r\n      <!-- 记录列表 -->\r\n      <div class=\"records-list\">\r\n        <div \r\n          v-for=\"(record, index) in filteredRecords\" \r\n          :key=\"record.id || index\"\r\n          class=\"record-item\"\r\n        >\r\n          <div class=\"record-content\">\r\n            <span class=\"website-icon\">🌐</span>\r\n            <span class=\"website-info\">\r\n              <span class=\"website-name\">{{ record.url }}</span>\r\n              <span class=\"divider\">|</span>\r\n              <span class=\"account-name\">{{ record.account }}</span>\r\n            </span>\r\n          </div>\r\n          <div class=\"record-actions\">\r\n            <button class=\"action-btn edit-btn\" @click=\"handleEdit(record)\" title=\"编辑\">\r\n              ✏️\r\n            </button>\r\n            <button class=\"action-btn delete-btn\" @click=\"handleDelete(record)\" title=\"删除\">\r\n              🗑️\r\n            </button>\r\n          </div>\r\n        </div>\r\n        \r\n        <!-- 空状态提示 -->\r\n        <div v-if=\"filteredRecords.length === 0\" class=\"empty-state\">\r\n          <p>暂无记录，请在右侧添加账号信息</p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  export default {\r\n    props: {\r\n      records: {\r\n        type: Array,\r\n        required: true\r\n      }\r\n    },\r\n    data() {\r\n      return {\r\n        activeTab: 'all',\r\n        searchQuery: ''\r\n      };\r\n    },\r\n    computed: {\r\n      filteredRecords() {\r\n        let filtered = [...this.records];\r\n        \r\n        // 搜索过滤\r\n        if (this.searchQuery) {\r\n          const query = this.searchQuery.toLowerCase();\r\n          filtered = filtered.filter(record => \r\n            record.url.toLowerCase().includes(query) ||\r\n            record.account.toLowerCase().includes(query)\r\n          );\r\n        }\r\n        \r\n        // 标签过滤\r\n        if (this.activeTab === 'recent') {\r\n          // 按时间戳排序，取最近5条\r\n          filtered.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));\r\n          return filtered.slice(0, 5);\r\n        }\r\n        \r\n        return filtered;\r\n      }\r\n    },\r\n    methods: {\r\n      handleEdit(record) {\r\n        this.$emit('edit-record', record);\r\n      },\r\n      handleDelete(record) {\r\n        const index = this.records.findIndex(r => r.id === record.id);\r\n        if (index !== -1) {\r\n          this.$emit('delete-record', index);\r\n        }\r\n      }\r\n    }\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .saved-records {\r\n    height: 100%;\r\n    display: flex;\r\n    flex-direction: column;\r\n  }\r\n  \r\n  .title {\r\n    font-size: 24px;\r\n    font-weight: 600;\r\n    margin-bottom: 20px;\r\n    color: #1a1a1a;\r\n  }\r\n  \r\n  .filter-tabs {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n    margin-bottom: 20px;\r\n    padding-bottom: 15px;\r\n    border-bottom: 1px solid #eee;\r\n  }\r\n  \r\n  .tab-btn {\r\n    padding: 8px 16px;\r\n    border: 1px solid #ddd;\r\n    border-radius: 20px;\r\n    background: #f5f5f5;\r\n    color: #666;\r\n    cursor: pointer;\r\n    transition: all 0.3s ease;\r\n    font-size: 14px;\r\n  }\r\n  \r\n  .tab-btn:hover {\r\n    background: #e9ecef;\r\n  }\r\n  \r\n  .tab-btn.active {\r\n    background: #007bff;\r\n    color: white;\r\n    border-color: #007bff;\r\n  }\r\n  \r\n  .search-input {\r\n    flex: 1;\r\n    padding: 8px 12px;\r\n    border: 1px solid #ddd;\r\n    border-radius: 20px;\r\n    font-size: 14px;\r\n    outline: none;\r\n    transition: border-color 0.3s ease;\r\n  }\r\n  \r\n  .search-input:focus {\r\n    border-color: #007bff;\r\n  }\r\n  \r\n  .records-list {\r\n    flex: 1;\r\n    overflow-y: auto;\r\n  }\r\n  \r\n  .record-item {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    padding: 12px 16px;\r\n    margin-bottom: 8px;\r\n    background: #f8f9fa;\r\n    border-radius: 8px;\r\n    transition: all 0.3s ease;\r\n  }\r\n  \r\n  .record-item:hover {\r\n    background: #e9ecef;\r\n    transform: translateY(-1px);\r\n    box-shadow: 0 2px 8px rgba(0,0,0,0.1);\r\n  }\r\n  \r\n  .record-content {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 12px;\r\n  }\r\n  \r\n  .website-icon {\r\n    font-size: 20px;\r\n  }\r\n  \r\n  .website-info {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 8px;\r\n  }\r\n  \r\n  .website-name {\r\n    font-weight: 500;\r\n    color: #333;\r\n  }\r\n  \r\n  .divider {\r\n    color: #999;\r\n  }\r\n  \r\n  .account-name {\r\n    color: #666;\r\n  }\r\n  \r\n  .record-actions {\r\n    display: flex;\r\n    gap: 8px;\r\n  }\r\n  \r\n  .action-btn {\r\n    padding: 6px 10px;\r\n    border: none;\r\n    border-radius: 6px;\r\n    cursor: pointer;\r\n    transition: all 0.3s ease;\r\n    font-size: 14px;\r\n    background: transparent;\r\n  }\r\n  \r\n  .edit-btn:hover {\r\n    background: #e7f3ff;\r\n    color: #007bff;\r\n  }\r\n  \r\n  .delete-btn:hover {\r\n    background: #ffe7e7;\r\n    color: #dc3545;\r\n  }\r\n  \r\n  .empty-state {\r\n    text-align: center;\r\n    padding: 40px 20px;\r\n    color: #999;\r\n    font-size: 14px;\r\n  }\r\n  \r\n  /* 滚动条样式 */\r\n  .records-list::-webkit-scrollbar {\r\n    width: 6px;\r\n  }\r\n  \r\n  .records-list::-webkit-scrollbar-track {\r\n    background: #f1f1f1;\r\n    border-radius: 3px;\r\n  }\r\n  \r\n  .records-list::-webkit-scrollbar-thumb {\r\n    background: #c1c1c1;\r\n    border-radius: 3px;\r\n  }\r\n  \r\n  .records-list::-webkit-scrollbar-thumb:hover {\r\n    background: #a8a8a8;\r\n  }\r\n  </style>\r\n  "],"mappings":";;EACSA,KAAK,EAAC;AAAe;;EAInBA,KAAK,EAAC;AAAa;;EAsBnBA,KAAK,EAAC;AAAc;;EAMhBA,KAAK,EAAC;AAAgB;;EAEnBA,KAAK,EAAC;AAAc;;EAClBA,KAAK,EAAC;AAAc;;EAEpBA,KAAK,EAAC;AAAc;;EAGzBA,KAAK,EAAC;AAAgB;;;;;EAWYA,KAAK,EAAC;;;uBAnDnDC,mBAAA,CAuDM,OAvDNC,UAuDM,G,0BAtDJC,mBAAA,CAA4B;IAAxBH,KAAK,EAAC;EAAO,GAAC,OAAK,qBAEvBI,mBAAA,UAAa,EACbD,mBAAA,CAmBM,OAnBNE,UAmBM,GAlBJF,mBAAA,CAKS;IAJNH,KAAK,EAAAM,eAAA;MAAAC,MAAA,EAAwBC,KAAA,CAAAC,SAAS;IAAA;IACtCC,OAAK,EAAAC,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAAEJ,KAAA,CAAAC,SAAS;KAClB,MAED,kBACAN,mBAAA,CAKS;IAJNH,KAAK,EAAAM,eAAA;MAAAC,MAAA,EAAwBC,KAAA,CAAAC,SAAS;IAAA;IACtCC,OAAK,EAAAC,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAAEJ,KAAA,CAAAC,SAAS;KAClB,MAED,kB,gBACAN,mBAAA,CAKE;IAJAU,IAAI,EAAC,MAAM;IACXb,KAAK,EAAC,cAAc;IACpBc,WAAW,EAAC,IAAI;+DACPN,KAAA,CAAAO,WAAW,GAAAH,MAAA;iDAAXJ,KAAA,CAAAO,WAAW,E,KAIxBX,mBAAA,UAAa,EACbD,mBAAA,CA4BM,OA5BNa,UA4BM,I,kBA3BJf,mBAAA,CAqBMgB,SAAA,QAAAC,WAAA,CApBsBC,QAAA,CAAAC,eAAe,GAAjCC,MAAM,EAAEC,KAAK;yBADvBrB,mBAAA,CAqBM;MAnBHsB,GAAG,EAAEF,MAAM,CAACG,EAAE,IAAIF,KAAK;MACxBtB,KAAK,EAAC;QAENG,mBAAA,CAOM,OAPNsB,UAOM,G,0BANJtB,mBAAA,CAAoC;MAA9BH,KAAK,EAAC;IAAc,GAAC,IAAE,qBAC7BG,mBAAA,CAIO,QAJPuB,UAIO,GAHLvB,mBAAA,CAAkD,QAAlDwB,UAAkD,EAAAC,gBAAA,CAApBP,MAAM,CAACQ,GAAG,kB,0BACxC1B,mBAAA,CAA8B;MAAxBH,KAAK,EAAC;IAAS,GAAC,GAAC,qBACvBG,mBAAA,CAAsD,QAAtD2B,UAAsD,EAAAF,gBAAA,CAAxBP,MAAM,CAACU,OAAO,iB,KAGhD5B,mBAAA,