{"ast":null,"code":"export default {\n  data() {\n    return {\n      activeTab: 'all',\n      searchQuery: '',\n      records: JSON.parse(localStorage.getItem('records')) || []\n    };\n  },\n  computed: {\n    filteredRecords() {\n      if (this.activeTab === 'all') {\n        return this.records;\n      } else if (this.activeTab === 'recent') {\n        return this.records.slice(-5);\n      }\n    }\n  },\n  watch: {\n    records: {\n      handler(newRecords) {\n        localStorage.setItem('records', JSON.stringify(newRecords));\n      },\n      deep: true\n    }\n  },\n  methods: {\n    editRecord(index) {\n      this.$emit('edit-record', this.records[index]);\n    },\n    deleteRecord(index) {\n      this.records.splice(index, 1);\n      this.$emit('update-records', this.records);\n    }\n  }\n};","map":{"version":3,"names":["data","activeTab","searchQuery","records","JSON","parse","localStorage","getItem","computed","filteredRecords","slice","watch","handler","newRecords","setItem","stringify","deep","methods","editRecord","index","$emit","deleteRecord","splice"],"sources":["C:\\Users\\23946\\Desktop\\account-manager\\src\\components\\SavedRecords.vue"],"sourcesContent":["<template>\r\n    <div class=\"saved-records\">\r\n      <h3>已保存记录</h3>\r\n      <div class=\"tabs\">\r\n        <button :class=\"{ active: activeTab === 'all' }\" @click=\"activeTab = 'all'\">全部</button>\r\n        <button :class=\"{ active: activeTab === 'recent' }\" @click=\"activeTab = 'recent'\">最近</button>\r\n        <input type=\"text\" placeholder=\"搜索\" v-model=\"searchQuery\" />\r\n      </div>\r\n      <ul>\r\n        <li v-for=\"(record, index) in filteredRecords\" :key=\"index\">\r\n          <span class=\"icon\">🌐</span> {{ record.url }} | {{ record.account }}\r\n          <span class=\"actions\">\r\n            <button class=\"edit\" @click=\"editRecord(index)\">✏️</button>\r\n            <button class=\"delete\" @click=\"deleteRecord(index)\">🗑️</button>\r\n          </span>\r\n        </li>\r\n      </ul>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  export default {\r\n    data() {\r\n      return {\r\n        activeTab: 'all',\r\n        searchQuery: '',\r\n        records: JSON.parse(localStorage.getItem('records')) || [],\r\n      };\r\n    },\r\n    computed: {\r\n      filteredRecords() {\r\n        if (this.activeTab === 'all') {\r\n          return this.records;\r\n        } else if (this.activeTab === 'recent') {\r\n          return this.records.slice(-5);\r\n        }\r\n      }\r\n    },\r\n    watch: {\r\n      records: {\r\n        handler(newRecords) {\r\n          localStorage.setItem('records', JSON.stringify(newRecords));\r\n        },\r\n        deep: true\r\n      }\r\n    },\r\n    methods: {\r\n      editRecord(index) {\r\n        this.$emit('edit-record', this.records[index]);\r\n      },\r\n      deleteRecord(index) {\r\n        this.records.splice(index, 1);\r\n        this.$emit('update-records', this.records);\r\n      }\r\n    }\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .saved-records {\r\n    padding: 20px;\r\n    border-right: 1px solid #ccc;\r\n  }\r\n  \r\n  .tabs {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    margin-bottom: 20px;\r\n  }\r\n  \r\n  button {\r\n    margin-right: 10px;\r\n    padding: 5px 10px;\r\n    border: none;\r\n    background-color: #f0f0f0;\r\n    cursor: pointer;\r\n  }\r\n  \r\n  button.active {\r\n    background-color: #ddd;\r\n    font-weight: bold;\r\n  }\r\n  \r\n  ul {\r\n    list-style-type: none;\r\n    padding: 0;\r\n  }\r\n  \r\n  li {\r\n    padding: 10px;\r\n    border-bottom: 1px solid #ddd;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n  }\r\n  \r\n  .icon {\r\n    margin-right: 10px;\r\n  }\r\n  \r\n  .actions button {\r\n    margin-left: 10px;\r\n  }\r\n  \r\n  .edit {\r\n    background-color: transparent;\r\n  }\r\n  \r\n  .delete {\r\n    background-color: transparent;\r\n  }\r\n  </style>\r\n  "],"mappings":"AAqBE,eAAe;EACbA,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,KAAK;MAChBC,WAAW,EAAE,EAAE;MACfC,OAAO,EAAEC,IAAI,CAACC,KAAK,CAACC,YAAY,CAACC,OAAO,CAAC,SAAS,CAAC,KAAK;IAC1D,CAAC;EACH,CAAC;EACDC,QAAQ,EAAE;IACRC,eAAeA,CAAA,EAAG;MAChB,IAAI,IAAI,CAACR,SAAQ,KAAM,KAAK,EAAE;QAC5B,OAAO,IAAI,CAACE,OAAO;MACrB,OAAO,IAAI,IAAI,CAACF,SAAQ,KAAM,QAAQ,EAAE;QACtC,OAAO,IAAI,CAACE,OAAO,CAACO,KAAK,CAAC,CAAC,CAAC,CAAC;MAC/B;IACF;EACF,CAAC;EACDC,KAAK,EAAE;IACLR,OAAO,EAAE;MACPS,OAAOA,CAACC,UAAU,EAAE;QAClBP,YAAY,CAACQ,OAAO,CAAC,SAAS,EAAEV,IAAI,CAACW,SAAS,CAACF,UAAU,CAAC,CAAC;MAC7D,CAAC;MACDG,IAAI,EAAE;IACR;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,UAAUA,CAACC,KAAK,EAAE;MAChB,IAAI,CAACC,KAAK,CAAC,aAAa,EAAE,IAAI,CAACjB,OAAO,CAACgB,KAAK,CAAC,CAAC;IAChD,CAAC;IACDE,YAAYA,CAACF,KAAK,EAAE;MAClB,IAAI,CAAChB,OAAO,CAACmB,MAAM,CAACH,KAAK,EAAE,CAAC,CAAC;MAC7B,IAAI,CAACC,KAAK,CAAC,gBAAgB,EAAE,IAAI,CAACjB,OAAO,CAAC;IAC5C;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}